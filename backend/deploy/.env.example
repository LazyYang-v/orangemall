# OrangeMall 部署密钥示例：复制为 backend/deploy/.env 后替换为随机值
#   cp backend/deploy/.env.example backend/deploy/.env
#   每个值用 `openssl rand -hex 24` 生成，切勿使用示例占位
JWT_SECRET=change-me-to-random-48-hex
PAY_SANDBOX_KEY=change-me-to-random-48-hex
INNER_SECRET=change-me-to-random-48-hex
# Grafana 管理员密码（--profile monitor；匿名访问为只读 Viewer）
GRAFANA_ADMIN_PASSWORD=change-me-to-random
# Seata TC 高可用（可选，Phase 5）：两个 TC 共用 seata 库；取消注释并以 --profile app --profile ha 启动
# SEATA_ADDR=seata:8091;seata-2:8091
